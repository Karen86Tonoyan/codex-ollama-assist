# Copy to config/ollama.env (never commit the copy).
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_ORIGINS=*
# Dummy key so Codex OpenAI-compat client is happy. Ollama ignores it.
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=gpt-oss:20b-gpu
# Optional ALFA gateway (HOLD stays HOLD). Leave empty to skip.
ALFA_GATEWAY_URL=http://127.0.0.1:8080
